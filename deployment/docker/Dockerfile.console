# AstraSync operator Console and OIDC BFF
FROM golang:1.22-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY control-plane/go.mod control-plane/go.sum ./control-plane/
COPY control-plane/auth/go.mod control-plane/auth/go.sum ./control-plane/auth/
COPY control-plane/catalog/go.mod control-plane/catalog/go.sum ./control-plane/catalog/
COPY control-plane/api-server/go.mod control-plane/api-server/go.sum ./control-plane/api-server/
COPY console/go.mod console/go.sum ./console/
WORKDIR /app/console
RUN go mod download

COPY control-plane/auth ../control-plane/auth
COPY control-plane/api-server/gen ../control-plane/api-server/gen
COPY console ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app/console-server ./cmd/console

FROM alpine:3.19

WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -g 1000 astra \
    && adduser -u 1000 -G astra -D astra

COPY --from=builder /app/console-server /app/console-server
RUN chown -R astra:astra /app

USER astra
EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8090/health || exit 1

ENTRYPOINT ["/app/console-server"]
