# AstraSync API Server
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Install protobuf dependencies
RUN apk add --no-cache protobuf git

# Copy go mod files
COPY control-plane/go.mod control-plane/go.sum ./
RUN go mod download

# Copy source code
COPY api ./api
COPY control-plane/api-server ./control-plane/api-server

# Build
WORKDIR /app/control-plane/api-server
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/server ./cmd/server

# Runtime image
FROM alpine:3.19

WORKDIR /app

# Install required packages
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 astra && \
    adduser -u 1000 -G astra -D astra

# Copy binary
COPY --from=builder /app/server /app/server

# Copy configuration
COPY config ./config

# Set ownership
RUN chown -R astra:astra /app

USER astra

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

# Expose ports
EXPOSE 8080 50051

ENTRYPOINT ["/app/server"]
