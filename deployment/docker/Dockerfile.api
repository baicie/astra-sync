# AstraSync API Server
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Install source dependency support
RUN apk add --no-cache git ca-certificates

# Download the API module and its replaced shared module independently.
COPY control-plane/go.mod control-plane/go.sum ./control-plane/
COPY control-plane/auth/go.mod control-plane/auth/go.sum ./control-plane/auth/
COPY control-plane/catalog/go.mod control-plane/catalog/go.sum ./control-plane/catalog/
COPY control-plane/api-server/go.mod control-plane/api-server/go.sum ./control-plane/api-server/
WORKDIR /app/control-plane/api-server
RUN go mod download

# Copy source code
COPY control-plane/job ../job
COPY control-plane/connection ../connection
COPY control-plane/auth ../auth
COPY control-plane/catalog ../catalog
COPY control-plane/api-server ./

# Build
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/server ./cmd/server

# Runtime image
FROM alpine:3.19

WORKDIR /app

# Install required packages
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 astra && \
    adduser -u 1000 -G astra -D astra

# Copy binary
COPY --from=builder /app/server /app/server
COPY deployment/catalog/connector-inventory.pb /app/catalog/connector-inventory.pb

# Set ownership
RUN chown -R astra:astra /app

USER astra

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

# Expose ports
EXPOSE 8080 50051

ENTRYPOINT ["/app/server"]
