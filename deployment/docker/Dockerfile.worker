# AstraSync Worker protocol service
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder

WORKDIR /workspace
COPY . .
RUN mvn -B -ntp -DskipTests -pl engine/worker -am package

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app
RUN addgroup -g 1000 astra \
    && adduser -u 1000 -G astra -D astra \
    && mkdir -p /app/plugins \
    && chown -R astra:astra /app

COPY --from=builder /workspace/engine/worker/target/worker-*-all.jar /app/astrasync-worker.jar

USER astra
EXPOSE 50051

ENV ASTRASYNC_WORKER_PORT=50051 \
    ASTRASYNC_MAX_CONCURRENT_TASKS=1 \
    ASTRASYNC_TASK_QUEUE_CAPACITY=0 \
    ASTRASYNC_MAX_CONNECTIONS=16 \
    JAVA_TOOL_OPTIONS="-XX:+UseG1GC -XX:MaxRAMPercentage=75"

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD ["java", "-cp", "/app/astrasync-worker.jar:/app/plugins/*", "io.astrasync.engine.worker.WorkerHealthProbe"]

ENTRYPOINT ["java", "-cp", "/app/astrasync-worker.jar:/app/plugins/*", "io.astrasync.engine.worker.WorkerApplication"]
