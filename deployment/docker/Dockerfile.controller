# AstraSync Controller
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY control-plane/go.mod control-plane/go.sum ./
RUN go mod download

# Copy source code
COPY api ./api
COPY control-plane/controller ./control-plane/controller

# Build
WORKDIR /app/control-plane/controller
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/controller ./cmd/controller

# Runtime image
FROM alpine:3.19

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 1000 astra && \
    adduser -u 1000 -G astra -D astra

COPY --from=builder /app/controller /app/controller
COPY config ./config

RUN chown -R astra:astra /app
USER astra

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:8081/health || exit 1

EXPOSE 8081

ENTRYPOINT ["/app/controller"]
