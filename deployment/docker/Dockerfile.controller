# AstraSync Controller
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Download the controller module and its replaced shared module independently.
COPY control-plane/go.mod control-plane/go.sum ./control-plane/
COPY control-plane/controller/go.mod control-plane/controller/go.sum ./control-plane/controller/
WORKDIR /app/control-plane/controller
RUN go mod download

# Copy source code
COPY control-plane/job ../job
COPY control-plane/controller ./

# Build
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/controller ./cmd/controller

# Runtime image
FROM alpine:3.19

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 1000 astra && \
    adduser -u 1000 -G astra -D astra

COPY --from=builder /app/controller /app/controller

RUN chown -R astra:astra /app
USER astra

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:8081/healthz || exit 1

EXPOSE 8081

ENTRYPOINT ["/app/controller"]
